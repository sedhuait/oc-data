dist/
__pycache__/
*.pyc
.DS_Store

# Working scratch from the fetch scripts. Source documents worth keeping live
# in documents/ and ARE committed — that is the point of them, so a published
# fact can be checked against the document it was read from.
tools/*/snapshots/
tools/*/mitc/
*.bundle

# Binary documents (PDFs) are uploaded to R2 bucket oc-documents (HLD §13.5).
# Only the documents.json index files are tracked in git.
documents/funds/sid/**/*.pdf



# Lists of named people (agents, terminated agents, intermediaries) that
# insurers publish on the same disclosure pages as policy wordings. Not
# product documents; stripped from history before publishing, 2026-09-30.
documents/insurance/*/*[Aa]gent*[Ll]ist*
documents/insurance/*/*[Tt]erminated*
documents/insurance/*/*[Ii]ntermediar*
documents/insurance/*/*[Mm]arketing-[Ff]irm*
documents/insurance/*/employer-employee*
documents/insurance/*/*corporate-agents*
